type tmmi_app, domain;

unix_socket_connect(tmmi_app, tctd, tctd);

allow tmmi_app vendor_sysfs_graphics:dir { search };
allow tmmi_app vendor_sysfs_graphics:file rw_file_perms;
allow tmmi_app vendor_sysfs_usb_supply:dir { search };
allow tmmi_app vendor_sysfs_usb_supply:file rw_file_perms;
allow tmmi_app vendor_sysfs_usb_controller:dir { search };
allow tmmi_app vendor_sysfs_usb_controller:file rw_file_perms;
set_prop(tmmi_app, vendor_sensors_prop)
set_prop(tmmi_app, vendor_camera_prop)
set_prop(tmmi_app, vendor_audio_prop)

allow tmmi_app tctd_socket:sock_file { write };
allow tmmi_app vendor_sysfs_battery_supply:dir { search };
get_prop(tmmi_app, vendor_display_prop)
set_prop(tmmi_app, ctl_start_prop)

set_prop(tmmi_app, vendor_fp_prop)

allow tmmi_app ff_hwservice:hwservice_manager { find };
allow tmmi_app hal_fingerprint_default:binder { call };

#allow tmmi_app vendor_file:file rx_file_perms;
allow tmmi_app vendor_file:dir { search };
allow tmmi_app vendor_file:file { execute getattr open read execute_no_trans };
#allow tmmi_app vendor_file:chr_file { read write open ioctl  };
#allow tmmi_app hal_audio_hwservice:hwservice_manager { find };
allow tmmi_app hal_audio_default:file w_file_perms;

allow tmmi_app audio_device:dir search;
allow tmmi_app audio_device:chr_file rw_file_perms;
allow tmmi_app audio_device:chr_file { read write ioctl open };
allow tmmi_app proc_asound:dir search;
allow tmmi_app proc_asound:file r_file_perms;

#typeattribute tmmi_app hal_audio_client;
hal_client_domain(tmmi_app, hal_audio)

allow tmmi_app vendor_persist_sensors_file:dir { search };
allow tmmi_app vendor_persist_sensors_file:file rw_file_perms;
