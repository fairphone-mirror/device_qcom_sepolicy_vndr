vndbinder_use(hal_camera_default);
allow hal_camera_default { vendor_sys_sp_comp vendor_sys_nonsp_comp }:file r_file_perms;

#chengming.xiang add for fp6 mmi dev begin
allow hal_camera_default fp_mmitest_sysfs:file { read write open getattr };
allow hal_camera_default fp_mmitest_sysfs:dir { search open read };
#chengming.xiang add for fp6 mmi dev end

#Begin added by juting.huang for cameraalgoservice
allow hal_camera_default vendor_camera_dump_file:file create_file_perms;
allow hal_camera_default vendor_camera_dump_file:dir create_dir_perms;
allow hal_camera_default vendor_tct_camera_algo_service:service_manager find;
binder_call(hal_camera_default, hal_algoservice_default)
#End added by juting.huang for cameraalgoservice

#start algoservice cache and model
allow hal_camera_default hal_algoservice_data_file:file create_file_perms;
allow hal_camera_default hal_algoservice_data_file:dir create_dir_perms;
#end
